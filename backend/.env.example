# Copie para .env e ajuste os valores
NODE_ENV=development
PORT=3333

# Conexão TiDB Cloud (compatível com MySQL). Pegue host/usuário/senha em:
# TiDB Cloud → seu cluster → Connect. Formato: mysql://USUARIO:SENHA@HOST:4000/BANCO
# - O usuário do TiDB Serverless tem um prefixo (ex.: 3xYz1abc.root).
# - Se a senha tiver caracteres especiais, codifique-os (@ → %40, # → %23, / → %2F).
# - O banco (ordem_do_chaos) é criado automaticamente na primeira execução.
DATABASE_URL=mysql://SEU_PREFIXO.root:SUA_SENHA@gateway01.us-east-1.prod.aws.tidbcloud.com:4000/ordem_do_chaos
# TLS é ligado automaticamente para *.tidbcloud.com. Para um MySQL local sem TLS: DB_SSL=false
# DB_SSL=true

# Autenticação (gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio-com-32-caracteres-ou-mais
JWT_EXPIRES_IN=7d

# Origens permitidas (separadas por vírgula)
CORS_ORIGIN=http://localhost:5173

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=15

# Token do modo mestre: quem informar este valor no Perfil vira mestre (mín. 8 caracteres).
# Trocar o valor revoga todos os mestres atuais.
MASTER_TOKEN=troque-este-token-do-mestre

# E-mail (SMTP) para enviar o código de confirmação do cadastro.
# Sem SMTP_HOST (só em desenvolvimento) o código aparece no terminal da API.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_PASS = "senha de app" de 16 letras
#        (Conta Google → Segurança → Verificação em duas etapas → Senhas de app).
# Outlook/Hotmail: smtp-mail.outlook.com, porta 587.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Remetente exibido (padrão: SMTP_USER)
MAIL_FROM=
# Nome do app no assunto/corpo do e-mail
APP_NAME=GREMAD

# Opcional: se definido, o cadastro exige este código (grupo fechado)
INVITE_CODE=

# Nível de log: fatal | error | warn | info | debug
LOG_LEVEL=info

# Cookie Secure (HTTPS). Padrão: true em produção
# COOKIE_SECURE=false

# Fuso horário usado para "hoje" (melhores datas, próximas sessões)
TZ=America/Sao_Paulo
