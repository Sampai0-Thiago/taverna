# Usado pelo docker compose (copie para .env)
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio-com-32-caracteres-ou-mais
INVITE_CODE=
MASTER_TOKEN=troque-este-token-do-mestre

# Banco no TiDB Cloud: mysql://USUARIO:SENHA@HOST:4000/gremad (ver backend/.env.example)
DATABASE_URL=

# E-mail do código de confirmação (obrigatório em produção): Brevo OU SMTP
BREVO_API_KEY=
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Cloudflare R2 (opcional no Docker: sem ele os uploads ficam no volume "uploads")
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
